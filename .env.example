# Supabase > Project Settings > API
# YALNIZCA "anon" / "publishable" anahtarını kullanın. service_role / secret anahtarını ASLA buraya koymayın.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Üretimde API ayrı bir sunucudaysa adresini girin; yerelde boş bırakarak Vite proxy'sini kullanın.
VITE_IPTV_API_URL=

# IPTV Xtream bilgileri (yalnızca Express sunucusunda kullanılır; frontend'e aktarılmaz)
IPTV_SERVER_URL=https://your-iptv-server.example:443
IPTV_USERNAME=your-iptv-username
IPTV_PASSWORD=your-iptv-password
# Live TV output format: hls (m3u8), mpegts (ts), or unset for TS
IPTV_STREAM_FORMAT=hls
# Optional comma-separated media/CDN hosts if HLS resources use a different hostname
IPTV_STREAM_HOSTS=
# Üretimde IPTV API'sine erişecek web sitesi adresleri (virgülle ayrılabilir)
IPTV_ALLOWED_ORIGINS=http://localhost:5173,https://your-site.example
# Separate subtitle CDN hostnames, if the provider uses one
IPTV_SUBTITLE_HOSTS=
